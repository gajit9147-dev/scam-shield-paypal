# Copy this file to server/.env. Fill values privately. Never commit server/.env.
# Needed for real PayPal sandbox calls and Gemini agent/checkout checks:
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
GEMINI_API_KEY=

# Optional local server settings (defaults: port 3001, client localhost:5173).
PORT=
CLIENT_ORIGIN=

# Optional Gemini model overrides. Agent defaults to Gemini 2.5 models.
GEMINI_MODEL=
AGENT_MODEL=

# Optional public HTTPS URL for webhook delivery. localhost cannot receive it.
# The server registers a sandbox webhook when PUBLIC_URL is supplied.
PUBLIC_URL=
PAYPAL_WEBHOOK_ID=

# Optional stable signing key; otherwise derived from the PayPal client secret.
REVIEW_TOKEN_SECRET=

# Optional fallback INR per USD (default 85) and spent-token log path.
DEMO_INR_PER_USD=
USED_TOKENS_FILE=

# Render supplies this automatically; leave unset locally and use PUBLIC_URL.
RENDER_EXTERNAL_URL=
