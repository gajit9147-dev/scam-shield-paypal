# Copy to server/.env only if configuration is needed later. Never commit keys.
PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# Optional: AI-assisted review (Hindi/Hinglish messages, clearer reasons).
# Without a key the app runs fully on the local rules + model.
# Get a free key at https://aistudio.google.com/apikey and put it in server/.env:
# GEMINI_API_KEY=paste-your-key-here
# GEMINI_MODEL=gemini-3.8-flash
